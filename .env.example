# View server only (npm run dev → /view, /api/v1/talent/view). Plugin config lives in OpenClaw.
NODE_ENV=development
PORT=3010
MEM0_API_KEY=mem0_xxx
MEM0_BASE_URL=https://api.mem0.ai
MEM0_TIMEOUT_MS=12000
MEM0_MAX_RETRIES=2
MEM0_RETRY_DELAY_MS=400
TALENTOS_USER_ID=talentos-default
# Optional: Bearer auth for /view and /api/v1/talent/view (leave empty to disable)
TALENTOS_API_KEY=
# Optional: for npm run smoke (default http://127.0.0.1:3010)
# TALENTOS_BASE_URL=http://127.0.0.1:3010
