# View server (optional: dashboard at /view). Hiring runs in OpenClaw plugin → Mem0.
NODE_ENV=development
PORT=3010
MEM0_API_KEY=mem0_xxx
MEM0_BASE_URL=https://api.mem0.ai
MEM0_TIMEOUT_MS=12000
MEM0_MAX_RETRIES=2
MEM0_RETRY_DELAY_MS=400
TALENTOS_USER_ID=talentos-default
# Optional: require Bearer token for /api/v1/talent/view and /view
TALENTOS_API_KEY=
